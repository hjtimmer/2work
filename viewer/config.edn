{:viewer
 {;; URL naar de echte SQLite-database (read-only gebruik)
  :database-url "jdbc:sqlite:/pad/naar/2work.db"

  ;; Aparte SQLite-database met gebruikers en hun tabelautorisaties.
  ;; Tabellen: viewer_gebruiker (username, password, naam) en
  ;; viewer_gebruiker_tabel (username, tabel). Een autorisatie
  ;; "alle" in viewer_gebruiker_tabel geeft toegang tot alle tabellen.
  :users-database-url "jdbc:sqlite:viewer_users.db"

  ;; Maximale sessie-expiratietijd in seconden. Bij elke geslaagde
  ;; database-actie wordt de expiratietijd ververst naar
  ;; nu + deze waarde.
  :sessie-max-seconden 1800

  ;; Poort waarop de server luistert
  :port 3000

  ;; Certificaat-instellingen (voorlopig gereserveerd; bijv. voor een
  ;; keystore met client-certificaten of TLS-configuratie)
  :certificaat {:username "cert-gebruiker"
                :password "cert-wachtwoord"
                :alias "tweede-alias"}

  ;; Optioneel: eerste keer vullen van de users-database. Bij de start
  ;; worden deze gebruikers in viewer_gebruiker gezet als de tabel nog
  ;; leeg is. Wachtwoorden en autorisaties beheer je daarna in de
  ;; users-database zelf.
  :initiele-gebruikers
  {"henk" {:password "henk123" :naam "Henk Timmermans" :tabellen ["alle"]}
   "gast" {:password "gast123" :naam "Gastgebruiker" :tabellen ["dossier" "Document"]}}}}
